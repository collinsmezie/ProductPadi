{
  "compilerOptions": {
    "target": "es2016",

    /* Modules */
    "module": "commonjs",
    "rootDir": "./",
    "moduleResolution": "node",
    "resolveJsonModule": true,

    /* JavaScript Support */

    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,

    /* Type Checking */
    "strict": true,

    /* Completeness */

    "skipLibCheck": true
  },
  "include": ["src/**/*", "env.d.ts", "ecosystem.config.js", "./swagger.yaml"]
}
